    "    filename='test.log',\n",
    "    level=logging.DEBUG, \n",
    "    format='%(asctime)s:%(levelname)s:%(message)s'\n",
    ")\n",
    "\n",
    "logger = logging.getLogger()\n",
    "\n",
    "logger.debug(\"This is a debug message\")\n",
    "logger.info(\"Logger successfully created\")"
